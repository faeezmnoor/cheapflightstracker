# Copy to `.env` for local runs:  set -a; source .env; set +a; python run.py
# In production these are GitHub repo Secrets (sensitive) / Variables (tunables).

# --- Provider: Google Flights (no API key needed) -------------------------
PROVIDER=googleflights
# Point of sale: Google prices by market, so these should match where you buy.
REGION=my
LANGUAGE=en
# Optional proxy URL for the fetcher (e.g. if your runner's IP gets blocked).
# FF_PROXY=http://user:pass@host:port
FETCH_RETRIES=3

# --- Email: Gmail SMTP with an app password -------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=your_16_char_app_password   # myaccount.google.com/apppasswords
EMAIL_TO=you@example.com
EMAIL_FROM=you@example.com

# --- What to scan (all optional; sensible defaults baked in) ---------------
ORIGIN=KUL
# Comma-separated Indonesian airport codes. Leave unset for all 26 airports
# confirmed reachable from KL by scripts/probe_destinations.py.
ROUTES=
CURRENCY=MYR
ADULTS=1
NONSTOP_ONLY=false
# Every date in the next 30 days is scanned (exhaustive, not sampled).
# DEPARTURE_OFFSETS overrides the window with an explicit list if you want.
DEPARTURE_WINDOW_DAYS=30
DEPARTURE_START_OFFSET=1
# DEPARTURE_OFFSETS=
# Round trips are off by default; a return prices as two one-ways. Enable to
# also scan returns (capped at MAX_TRIP_DAYS from departure).
ROUND_TRIP=false
ROUND_TRIP_OFFSETS=2,5,8,11,14,17,20,23,26,29
STAY_LENGTHS=7,14
MAX_TRIP_DAYS=30

# --- Deal sensitivity ------------------------------------------------------
# A fare qualifies on ANY of: a new low, the rare tail, a robust z-score
# (corroborated by the percentile), or a plain large discount — always subject
# to the two floors, so trivial dips never reach the inbox.
MIN_DISCOUNT=0.12       # floor: below this it is noise, whatever the z-score
MIN_SAVING=40           # floor: cash saving worth an email
DEAL_THRESHOLD=0.20     # discount that qualifies on its own
RARE_PERCENTILE=0.10    # bottom 10% of prices ever seen for the route
DEAL_Z=-2.0             # robust (MAD-based) deviations below usual
Z_PERCENTILE_GUARD=0.25 # a z-score only counts if rarity agrees

# "Severe" means rare AND large: a route sitting at one fare all week scores
# an extreme z on a 14% dip that deserves no shouting.
SEVERE_THRESHOLD=0.35     # discount large enough on its own
SEVERE_DISCOUNT_FLOOR=0.25 # ...or this much off, if also rare/a new low
SEVERE_Z=-3.0
SEVERE_PERCENTILE=0.02

MIN_SAMPLES=5           # days of route history before flagging
HISTORY_WINDOW_DAYS=90  # how far back "usual price" looks

# --- Not saying the same thing twice ---------------------------------------
# Statistics decide whether a fare is unusual; they cannot decide whether it
# is news. A fare that stays cheap stays unusual, so re-alert only when it
# drops further or enough days pass.
REPEAT_IMPROVEMENT=0.05   # must be 5% cheaper than the last alert
REPEAT_COOLDOWN_DAYS=7    # ...or 7 days since we last mentioned it
ALERT_STATE_PATH=data/alert_state.json
# Prior sightings of the SAME departure date before that date's own history is
# quoted alongside an alert (annotation only — too noisy to originate one).
MIN_DATE_SAMPLES=3

# --- Behaviour -------------------------------------------------------------
ALWAYS_EMAIL=true       # email even on no-deal days (a daily digest)
DRY_RUN=false           # true = print the email instead of sending
HISTORY_PATH=data/price_history.json
DATE_HISTORY_PATH=data/date_prices.json
DIGEST_ARTIFACT_PATH=artifacts/digest.json  # digest + payload the auditor reads

# --- Rarity, not just cheapness --------------------------------------------
# A discount alone is not news. A fare that steps down to a new level and holds
# there keeps scoring "20% off" until the median catches up days later — one
# route sat at the same price for four days while its discount stayed 23% and
# its percentile climbed to 38%. A qualifying discount must also still be rare.
DEAL_PERCENTILE_GUARD=0.25

# --- Partial scrapes -------------------------------------------------------
# The provider answers a throttled request with HTTP 200 and no itineraries,
# which is indistinguishable from "no flights that day". A route returning
# fewer than this share of the scanned window is reporting the minimum of a
# sample, not of the window: it is labelled in the digest, cannot alert, and is
# not recorded — an inflated daily-cheapest raises the median and manufactures
# a fake deal tomorrow.
MIN_DATE_COVERAGE=0.50
# Re-ask an empty search once, up to this many times per shard. 0 disables it.
EMPTY_RETRY_BUDGET=60

# --- Far horizon (weekly, separate workflow) -------------------------------
# Two contiguous 30-day blocks scanned in full, compared min-to-min against the
# next 30 days. Blocks rather than a sparse sample because taking 10 of 30
# dates misses the true cheapest fare 41% of the time and reads ~14% high.
HORIZON_BLOCK_STARTS=90,150   # days out that each block begins
HORIZON_BLOCK_DAYS=30
HORIZON_MIN_DISCOUNT=0.15     # how much cheaper a block must be to mention it
# Both windows must be this covered before they are compared. Coverage drives
# the bias: 50% coverage inflates a window's minimum ~12%, 80% inflates ~3.6%.
HORIZON_MIN_COVERAGE=0.80
HORIZON_PATH=data/horizon_prices.json
